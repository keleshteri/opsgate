{
  "name": "opsgate",
  "version": "1.0.0",
  "description": "Smart SSH manager and gateway for DevOps engineers",
  "type": "module",
  "bin": {
    "opsgate": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "setup": "bash setup.sh",
    "audit:check": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "conf": "12.0.0",
    "fuse.js": "7.3.0",
    "inquirer": "9.3.8",
    "nanoid": "5.1.11"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.8",
    "@types/node": "^20.17.57",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
